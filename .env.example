# Copy to .env.local and fill in. Never commit .env.local.
# Reference: docs/standards/form-protection.md

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_WEBHOOK_SECRET=
# Sanity → POST /api/revalidate (signed webhook). Match the webhook Secret in sanity.io/manage.
SANITY_REVALIDATE_SECRET=
SANITY_API_WRITE_TOKEN=
VERCEL_OIDC_TOKEN=

# === Anthropic (AI concierge chat) ===
ANTHROPIC_API_KEY=

# === Supabase (vizantir project) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Cloudflare Turnstile ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Rate limiting ===
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# === Resend (transactional email) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# === Intel (internal dashboard) ===
# Comma-separated allowlist. Public signups are disabled in Supabase.
INTEL_ALLOWED_EMAILS=vizantirmarketing@gmail.com

# === Site ===
NEXT_PUBLIC_SITE_URL=
